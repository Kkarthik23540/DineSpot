<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".AdminDashboardActivity"
    android:background="#A2D4DE"
    >

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        android:title="Admin Dashboard"
        android:titleTextColor="@android:color/white"
        android:popupTheme="@style/ThemeOverlay.AppCompat.Dark" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="9dp"
            android:gravity="start"
            android:background="#A2D4DE"
            >


            <Spinner
                android:id="@+id/spinnerSort"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@android:drawable/btn_dropdown"
                android:spinnerMode="dropdown"
                android:importantForAccessibility="yes" />

            <Spinner
                android:id="@+id/spinnerDateFilter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:background="@android:drawable/btn_dropdown"
                android:spinnerMode="dropdown"
                android:importantForAccessibility="yes" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_gravity="center"
                android:layout_marginTop="20dp" />

            <TextView
                android:id="@+id/tvRestaurantCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Total Restaurants: "
                android:textSize="16sp"
                android:padding="10dp"
                android:background="?android:attr/selectableItemBackground"
                android:textColor="#118D9D"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/tvBookingCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Total Bookings: "
                android:textSize="16sp"
                android:padding="10dp"
                android:background="?android:attr/selectableItemBackground"
                android:textColor="#118D9D"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Booking Details"
                android:textSize="20sp"
                android:textColor="#118D9D"
                android:paddingTop="10dp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvNoBookingsMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No bookings available."
                android:layout_gravity="center"
                android:textSize="18sp"
                android:visibility="gone"
                android:textColor="#118D9D"
                android:layout_marginTop="10dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewBookings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
