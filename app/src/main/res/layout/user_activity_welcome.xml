<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/welcome_gradient">

    <!-- Subtle Background Shapes (Restored Corner Decorations) -->
    <View
        android:layout_width="350dp"
        android:layout_height="350dp"
        android:background="@drawable/circle_white_bg"
        android:backgroundTint="#0FFFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="-120dp"
        android:layout_marginEnd="-120dp" />

    <View
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:background="@drawable/circle_white_bg"
        android:backgroundTint="#0AFFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="-80dp"
        android:layout_marginStart="-80dp" />

    <!-- Branding Group (Centered) -->
    <LinearLayout
        android:id="@+id/brandingGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/logoCard"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:alpha="0"
            android:scaleX="0.5"
            android:scaleY="0.5"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="90dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerInside"
                android:src="@mipmap/dine_spot_logo"
                />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/appTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:alpha="0"
            android:text="DineSpot"
            android:textColor="@color/white"
            android:textSize="48sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02"
            android:fontFamily="@font/poppins"
            android:shadowColor="#33000000"
            android:shadowDx="2"
            android:shadowDy="4"
            android:shadowRadius="6" />

        <TextView
            android:id="@+id/appTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:alpha="0"
            android:text="Where Table Awaits"
            android:textColor="#BBFFFFFF"
            android:textSize="16sp"
            android:letterSpacing="0.05"
            android:fontFamily="@font/poppins" />

    </LinearLayout>

    <!-- Bottom Layer: Adaptive Content -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Onboarding View (For First-time Users) -->
        <LinearLayout
            android:id="@+id/onboardingLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="40dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="By continuing, you agree to our Terms and Conditions"
                android:textColor="#99FFFFFF"
                android:textSize="11sp"
                android:layout_marginBottom="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGetStarted"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Agree and Continue"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="16sp"
                app:cornerRadius="16dp"
                app:backgroundTint="@color/white"
                android:textColor="@color/colorPrimary"
                app:elevation="8dp" />
        </LinearLayout>

        <!-- Loading View (For Registered Users) -->
        <LinearLayout
            android:id="@+id/bottomArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvLoadingMsg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Preparing your experience..."
                android:textColor="#88FFFFFF"
                android:textSize="12sp"
                android:alpha="0"
                android:layout_marginBottom="16dp" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/welcomeProgress"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                app:indicatorColor="@color/white"
                app:trackColor="#22FFFFFF"
                app:trackCornerRadius="4dp"
                app:trackThickness="3dp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>